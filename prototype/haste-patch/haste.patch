+                _ => { if skip_depth.is_none(){out.push(ch);} } } }
+        out };
+    let expr = match vartype::parse(cleaned.as_str()) { Ok(e) => e, Err(e) => { eprintln!("VARTYPE FAIL: {}", cleaned); return Err(e.into()); } };
